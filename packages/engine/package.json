{
  "name": "@digitaplatform/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:identity": "tsx scripts/migrate-identity-refs.ts",
    "migrate:dedupe-files": "tsx scripts/migrate-dedupe-files.ts",
    "test:coverage": "vitest run --coverage --coverage.include='src/**'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/lib-storage": "^3.1069.0",
    "@digitaplatform/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.1",
    "jimp": "0.22.12",
    "jose": "^6.2.3",
    "jsep": "^1.4.0",
    "mongodb": "^7.3.0",
    "otpauth": "^9.5.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-seq": "^4.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "aws-sdk-client-mock": "^4.1.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "ws": "^8.21.0"
  }
}
