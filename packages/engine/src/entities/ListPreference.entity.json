{
  "name": "ListPreference",
  "module": "core",
  "database": "core",
  "label": "Saved View",
  "label_plural": "Saved Views",
  "description": "A named saved list view (filters + sort + columns + page size) for one entity, applied BY REFERENCE in digita-platform/packages/ui (?view=<id>; the URL stays clean until the user forks it by editing). Owner is stamped by the write pipeline (plain email id + denormalized owner_name). Visibility: private (owner only) | shared (shared_with_roles and/or shared_with_users) | everyone. Write/delete are if_owner (only the owner edits/deletes; Administrator bypasses); read is unconditional and the visible set is filtered by visibility (client + a view-scope query). is_default = the owner's auto-applied default for this entity; is_org_default = an Administrator-set fallback for users with no default of their own.",
  "icon": "list-filter",
  "naming": { "strategy": "uuid" },
  "is_single": false,
  "is_submittable": false,
  "track_changes": false,
  "title_field": "view_name",
  "search_fields": ["view_name", "entity"],
  "default_sort": { "field": "view_name", "order": "asc" },
  "in_global_search": false,
  "fields": [
    { "fieldname": "view_name", "fieldtype": "Data", "label": "View Name", "required": true, "in_list_view": true, "idx": 1 },
    { "fieldname": "entity", "fieldtype": "Data", "label": "Entity", "required": true, "in_list_view": true, "in_standard_filter": true, "idx": 2 },
    { "fieldname": "sb_owner", "fieldtype": "SectionBreak", "label": "Ownership & Sharing", "idx": 9 },
    { "fieldname": "owner_name", "fieldtype": "Data", "label": "Owner", "read_only": true, "in_list_view": true, "idx": 10 },
    { "fieldname": "visibility", "fieldtype": "Select", "label": "Visibility", "options": "private\nshared\neveryone", "default": "private", "in_list_view": true, "in_standard_filter": true, "idx": 11 },
    { "fieldname": "shared_with_roles", "fieldtype": "JSON", "label": "Shared with roles", "description": "role names, used when visibility = shared", "depends_on": "eval:doc.visibility=='shared'", "idx": 12 },
    { "fieldname": "shared_with_users", "fieldtype": "JSON", "label": "Shared with users", "description": "user email ids, used when visibility = shared", "depends_on": "eval:doc.visibility=='shared'", "idx": 13 },
    { "fieldname": "is_default", "fieldtype": "Check", "label": "My default for this entity", "default": 0, "idx": 14 },
    { "fieldname": "is_org_default", "fieldtype": "Check", "label": "Org default (admin)", "default": 0, "idx": 15 },
    { "fieldname": "sb_state", "fieldtype": "SectionBreak", "label": "Saved State", "idx": 19 },
    { "fieldname": "filters", "fieldtype": "JSON", "label": "Filters (AND)", "description": "[[field, op, value], …]", "idx": 20 },
    { "fieldname": "or_filters", "fieldtype": "JSON", "label": "Filters (OR)", "idx": 21 },
    { "fieldname": "order_by", "fieldtype": "Data", "label": "Sort", "description": "\"field dir, …\"", "idx": 22 },
    { "fieldname": "columns", "fieldtype": "JSON", "label": "Visible Columns", "description": "ordered fieldnames; null → in_list_view default", "idx": 23 },
    { "fieldname": "page_size", "fieldtype": "Int", "label": "Page Size", "default": 20, "idx": 24 }
  ],
  "permissions": [
    { "role": "Administrator", "level": 0, "select": 1, "read": 1, "write": 1, "create": 1, "delete": 1 },
    { "role": "System User", "level": 0, "select": 1, "read": 1, "create": 1 },
    { "role": "System User", "level": 0, "write": 1, "delete": 1, "if_owner": true }
  ],
  "indexes": [
    { "fields": ["owner", "entity"], "name": "idx_listpref_owner_entity" },
    { "fields": ["entity", "visibility"], "name": "idx_listpref_entity_visibility" }
  ]
}
