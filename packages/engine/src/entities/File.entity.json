{
  "name": "File",
  "module": "core",
  "database": "core",
  "label": "File",
  "label_plural": "Files",
  "naming": { "strategy": "auto_increment", "prefix": "FILE-", "pad_length": 6 },
  "is_submittable": false,
  "track_changes": false,
  "title_field": "file_name",
  "search_fields": ["file_name"],
  "default_sort": { "field": "creation", "order": "desc" },
  "fields": [
    { "fieldname": "file_name", "fieldtype": "Data", "label": "File Name", "required": true, "in_list_view": true, "in_global_search": true, "idx": 1 },
    { "fieldname": "file_url", "fieldtype": "Data", "label": "File URL", "required": true, "idx": 2 },
    { "fieldname": "file_size", "fieldtype": "Int", "label": "File Size (bytes)", "read_only": true, "in_list_view": true, "idx": 3 },
    { "fieldname": "file_type", "fieldtype": "Data", "label": "MIME Type", "read_only": true, "in_standard_filter": true, "idx": 4 },
    { "fieldname": "cb_1", "fieldtype": "ColumnBreak", "idx": 5 },
    { "fieldname": "attached_to_entity", "fieldtype": "Data", "label": "Attached To Entity", "in_standard_filter": true, "idx": 6 },
    { "fieldname": "attached_to_name", "fieldtype": "Data", "label": "Attached To Document", "idx": 7 },
    { "fieldname": "attached_to_field", "fieldtype": "Data", "label": "Attached To Field", "idx": 8 },
    { "fieldname": "is_private", "fieldtype": "Check", "label": "Private", "default": true, "read_only": true, "in_standard_filter": true, "description": "Server-managed: derived at upload from the target field's public opt-in. read_only so a client cannot flip a private file public via the generic update API (the upload router sets it via a raw insert, bypassing this guard).", "idx": 9 },
    { "fieldname": "thumbnail_url", "fieldtype": "Data", "label": "Thumbnail URL", "idx": 10 },
    { "fieldname": "storage_key", "fieldtype": "Data", "label": "Storage Key", "read_only": true, "idx": 11 },
    { "fieldname": "storage_backend", "fieldtype": "Data", "label": "Storage Backend", "read_only": true, "idx": 12 },
    { "fieldname": "content_hash", "fieldtype": "Data", "label": "Content Hash (SHA-256)", "read_only": true, "idx": 13 },
    { "fieldname": "thumbnail_key", "fieldtype": "Data", "label": "Thumbnail Storage Key", "read_only": true, "idx": 14 }
  ],
  "indexes": [
    { "fields": ["attached_to_entity", "attached_to_name"], "name": "idx_attached" },
    { "fields": ["storage_key"], "name": "idx_storage_key" },
    { "fields": ["content_hash"], "name": "idx_content_hash" },
    { "fields": ["file_name"], "name": "idx_search", "type": "text" }
  ],
  "permissions": [
    { "role": "Administrator", "level": 0, "select": 1, "read": 1, "write": 1, "create": 1, "delete": 1 },
    { "role": "System User", "level": 0, "select": 1, "read": 1, "write": 1, "create": 1, "delete": 1, "if_owner": true }
  ]
}
