{
  "name": "@digitaplatform/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digita Frontend — generic, app-agnostic operator UI. Renders whatever app the engine runs, 100% from metadata. React/Vite/Tailwind; httpOnly-cookie sessions via digita-auth.",
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --mode remote",
    "build": "tsc --noEmit && vite build",
    "build:vendor": "node vendor/build-vendor.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@digitaplatform/components": "workspace:*",
    "@digitaplatform/digita": "^0.1.0",
    "@digitaplatform/plugins": "workspace:*",
    "@digitaplatform/shared": "workspace:*",
    "@digitaplatform/theme": "workspace:*",
    "@digitaplatform/usermenu": "^0.1.0",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "country-flag-emoji-polyfill": "^0.1.8",
    "dompurify": "^3.4.10",
    "lucide-react": "^0.562.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^2.15.4",
    "zod": "3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
