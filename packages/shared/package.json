{
  "name": "@digitaplatform/shared",
  "version": "0.1.0",
  "type": "module",
  "description": "Digita shared contracts: TypeScript types (ApiResponse, EntityDefinition, FieldTypes, Permissions), the cross-service auth contract, and the plugin-SDK surface. Consumed by every Digita service.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitaplatform/digita-platform.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
